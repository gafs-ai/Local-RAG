<Window x:Class="LocalRag.Desktop.HelpWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Local RAG — ヘルプ" Width="980" Height="720" MinWidth="760" MinHeight="500"
 FontFamily="Yu Gothic UI" FontSize="14" WindowStartupLocation="CenterOwner" Background="#F5F7FA">
 <Grid Margin="24">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <TextBlock Text="設定ヘルプ" FontSize="26" FontWeight="SemiBold" Foreground="#17334B" Margin="0,0,0,16"/>
  <Grid Grid.Row="1">
   <Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="20"/><ColumnDefinition/></Grid.ColumnDefinitions>
   <DockPanel>
    <StackPanel DockPanel.Dock="Top"><TextBlock Text="設定名・説明を検索"/><TextBox x:Name="FilterBox" TextChanged="FilterChanged" Margin="0,6,0,12" Padding="8" AutomationProperties.Name="ヘルプ検索"/></StackPanel>
    <ListBox x:Name="TopicList" SelectionChanged="TopicChanged" AutomationProperties.Name="ヘルプ項目一覧" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
     <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Title}" TextWrapping="Wrap"/></DataTemplate></ListBox.ItemTemplate>
     <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="8"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="AutomationProperties.Name" Value="{Binding Title}"/></Style></ListBox.ItemContainerStyle>
    </ListBox>
   </DockPanel>
   <Border Grid.Column="2" Background="White" BorderBrush="#D9E1EA" BorderThickness="1" Padding="20">
    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
     <TextBlock x:Name="TopicTitle" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,16"/>
     <TextBox x:Name="TopicBody" IsReadOnly="True" IsReadOnlyCaretVisible="False" BorderThickness="0" Background="Transparent" TextWrapping="Wrap" AcceptsReturn="True" Padding="0" AutomationProperties.Name="ヘルプ本文"/>
     <StackPanel x:Name="TopicLinks" Margin="0,16,0,0"/>
    </StackPanel></ScrollViewer>
   </Border>
  </Grid>
 </Grid>
</Window>
