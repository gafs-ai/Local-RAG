<Window x:Class="LocalRag.Desktop.ManagementWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Local RAG — 処理設定" Width="1120" Height="860" MinWidth="920" MinHeight="700"
 FontFamily="Yu Gothic UI" FontSize="14" Background="#F5F7FA" WindowStartupLocation="CenterOwner">
 <Grid Margin="24">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,16">
   <Button DockPanel.Dock="Right" Content="設定ヘルプ (F1)" Click="OpenHelp" VerticalAlignment="Top" AutomationProperties.Name="処理設定ヘルプを開く"/>
   <StackPanel><TextBlock Text="処理設定" FontSize="26" FontWeight="SemiBold" Foreground="#17334B"/>
   <TextBlock Text="編集内容は「保存して適用」で反映し、必要な工程だけを再処理します。各項目でF1を押すと説明を表示します。" TextWrapping="Wrap" Margin="0,6,0,0"/></StackPanel>
  </DockPanel>
  <TabControl x:Name="ManagerTabs" Grid.Row="1" Padding="16" SelectionChanged="TabChanged">
   <TabItem Header="プロンプト管理">
    <Grid Margin="0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="20"/><ColumnDefinition/></Grid.ColumnDefinitions>
     <DockPanel><StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0"><WrapPanel>
      <Button Content="白紙から作成" Click="NewPrompt"/><Button Content="コピー" Click="CopyPrompt"/></WrapPanel>
      <Button Content="選択したプロンプトを削除" Click="DeletePrompt" Margin="0,8,0,0"/></StackPanel>
      <ListBox x:Name="PromptList" DisplayMemberPath="Name" SelectionChanged="PromptSelected" AutomationProperties.Name="プロンプト一覧"/></DockPanel>
     <Grid Grid.Column="2" x:Name="PromptEditor"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
      <TextBlock x:Name="PromptNotice" TextWrapping="Wrap" Foreground="#755620" Margin="0,0,0,12"/>
      <StackPanel Grid.Row="1"><TextBlock Text="名前"/><TextBox x:Name="PromptNameBox" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="プロンプト名"/></StackPanel>
      <StackPanel Grid.Row="2"><TextBlock Text="用途"/><ComboBox x:Name="PromptPurposeBox" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Purpose}" AutomationProperties.Name="プロンプトの用途"/></StackPanel>
      <TextBlock Grid.Row="3" Text="本文（用途ごとに標準プロンプトと同じJSON応答形式を使用します）" TextWrapping="Wrap"/>
      <TextBox Grid.Row="4" x:Name="PromptBodyBox" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="プロンプト本文"/>
     </Grid>
    </Grid>
   </TabItem>
   <TabItem Header="カテゴリ管理">
    <DockPanel Margin="0,8"><StackPanel DockPanel.Dock="Top"><TextBlock Text="カテゴリ名を入力します。説明は空欄でも構いません。「検索対象外」はそのカテゴリの文書を索引に公開しません。" TextWrapping="Wrap" Margin="0,0,0,12"/>
     <WrapPanel Margin="0,0,0,12"><Button Content="カテゴリを追加" Click="AddCategory"/><Button Content="選択したカテゴリを削除" Click="DeleteCategory"/></WrapPanel></StackPanel>
     <DataGrid x:Name="CategoryGrid" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single" AutomationProperties.Name="カテゴリ一覧">
      <DataGrid.Columns><DataGridTextColumn Header="カテゴリ名" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="220"/>
       <DataGridTextColumn Header="説明（任意）" Binding="{Binding Description, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
       <DataGridCheckBoxColumn Header="検索対象外" Binding="{Binding Excluded, UpdateSourceTrigger=PropertyChanged}" Width="110"/>
      </DataGrid.Columns></DataGrid>
    </DockPanel>
   </TabItem>
   <TabItem Header="テキスト処理">
    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,8">
     <TextBlock Text="上から順に確認し、拡張子が一致した最初の設定を適用します。共通設定にも .txt などの拡張子を指定し、下へ配置してください。一致する設定がないファイルは対象外です。" TextWrapping="Wrap" Foreground="#526477" Margin="0,0,0,12"/>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="240"/><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions>
      <StackPanel><TextBlock Text="適用する設定（上が優先）"/><ListBox x:Name="RouteList" DisplayMemberPath="Label" Height="230" SelectionChanged="RouteSelected" AutomationProperties.Name="適用する設定"/>
       <WrapPanel Margin="0,8"><Button Content="上へ" Tag="up" Click="MoveRoute"/><Button Content="下へ" Tag="down" Click="MoveRoute"/></WrapPanel>
       <TextBlock Text="追加する処理"/>
       <ComboBox x:Name="AddSourceModeBox" DisplayMemberPath="Label" SelectedValuePath="Key" AutomationProperties.Name="追加する処理"/>
       <Button Content="設定を追加" Click="AddRoute"/>
       <Button Content="選択した設定を削除" Click="RemoveRoute" Margin="0,8,0,0"/>
      </StackPanel>
      <StackPanel Grid.Column="2">
       <TextBlock Text="設定名"/><TextBox x:Name="RouteNameBox" AutomationProperties.Name="設定名"/>
       <TextBlock Text="この設定を適用する拡張子（例：.txt .md）"/><TextBox x:Name="RouteExtensionsBox" TextChanged="UsageChanged" AutomationProperties.Name="設定の拡張子"/>
       <TextBlock Text="入力の扱い"/><ComboBox x:Name="SourceModeBox" SelectionChanged="UsageChanged" DisplayMemberPath="Label" SelectedValuePath="Key" AutomationProperties.Name="入力の扱い"/>
       <StackPanel x:Name="EncodingOptions">
       <TextBlock Text="文字コード"/><ComboBox x:Name="EncodingModeBox" DisplayMemberPath="Name" SelectedValuePath="Mode" AutomationProperties.Name="文字コード"/>
       <TextBlock Text="通常は自動判別を使用します。短文などで判別できない場合や文字化けする場合は、この設定の文字コードを指定してください。" TextWrapping="Wrap" Foreground="#526477"/>
       </StackPanel>
       <StackPanel x:Name="PdfOptions">
       <TextBlock Text="PDFの取り込み判定" FontWeight="Bold"/>
       <ComboBox x:Name="PdfPolicyBox" DisplayMemberPath="Label" SelectedValuePath="Key" SelectionChanged="UsageChanged" AutomationProperties.Name="PDFの取り込み判定"/>
       <StackPanel x:Name="PdfSamplingOptions"><TextBlock Text="自動判定で調べる最大ページ数（3～63）"/><TextBox x:Name="PdfSamplesBox" AutomationProperties.Name="PDFの最大サンプルページ数"/></StackPanel>
       <CheckBox x:Name="PdfHeadersBox" Content="繰り返すヘッダー・フッターとページ番号を除去する"/>
       <TextBlock Text="自動では中央寄りのページから文字量と画像・図形の面積を調べます。文字情報が乏しいPDFは省略します。画像や図表の意味、画像内の文字は解析しません。内容の確認には原本を開いてください。" TextWrapping="Wrap"/>
       </StackPanel>
       <StackPanel x:Name="WordOptions">
       <TextBlock Text="Markdownへ変換・構造補正" FontWeight="Bold"/>
       <TextBlock x:Name="WordDescription" Text=".docx / .docmはWordを起動せず変換します。.docにはインストール済みのMicrosoft Wordが必要です。ヘッダー・フッターは本文から除去し、機密ラベルを保持します。画像内文字のOCRは未対応です。" TextWrapping="Wrap"/>
       <CheckBox x:Name="WordHeadingsBox" Content="見た目から短い見出しを補正する"/>
       <CheckBox x:Name="WordLineBreaksBox" Content="段落内の手動改行を結合する"/>
       <CheckBox x:Name="WordRepairBox" Content="LLMで見出し・分断された段落を補正する" Checked="UsageChanged" Unchecked="UsageChanged"/>
       <StackPanel x:Name="WordRepairPromptOptions">
       <TextBlock Text="構造補正プロンプト"/><ComboBox x:Name="WordRepairPromptBox" DisplayMemberPath="Label" SelectedValuePath="Key" AutomationProperties.Name="文書の構造補正プロンプト"/>
       <TextBlock Text="本文の追加・削除は行いません。応答が不正な場合は差し戻し後、変換結果を保持します。詩・住所等の意図的な改行は結合を無効にしてください。" TextWrapping="Wrap" Foreground="#526477"/>
       </StackPanel>
       </StackPanel>
       <StackPanel x:Name="CodeOptions">
       <TextBlock Text="コード説明プロンプト"/><ComboBox x:Name="CodePromptBox" DisplayMemberPath="Label" SelectedValuePath="Key" AutomationProperties.Name="コード説明プロンプト"/>
       <TextBlock Text="選んだ言語の構文で解析し、関数／クラス／ファイルの説明を埋め込みます。コード用の設定には通常の整形・結合を適用しません。Word・PDFなどのバイナリは変換しません。" TextWrapping="Wrap" Foreground="#526477" Margin="0,4,0,10"/>
       </StackPanel>
       <CheckBox x:Name="ClassifyBox" Content="分類を行う" Checked="UsageChanged" Unchecked="UsageChanged" Margin="0,0,0,10"/>
       <StackPanel x:Name="ClassifyOptions">
       <TextBlock Text="分類プロンプト"/><ComboBox x:Name="ClassifyPromptBox" DisplayMemberPath="Label" SelectedValuePath="Key" AutomationProperties.Name="分類プロンプト"/>
       </StackPanel>
       <TextBlock x:Name="DefaultCategoryLabel" Text="既定カテゴリ（分類を省略した場合・分類結果が割れた場合に使用）" TextWrapping="Wrap"/><ComboBox x:Name="DefaultCategoryBox" SelectionChanged="UsageChanged" DisplayMemberPath="Name" SelectedValuePath="Id" AutomationProperties.Name="既定カテゴリ"/>
       <StackPanel x:Name="TextOptions">
       <StackPanel x:Name="DefaultFormatOptions">
       <TextBlock Text="整形の既定処理"/><ComboBox x:Name="DefaultFormatBox" SelectionChanged="UsageChanged" DisplayMemberPath="Label" SelectedValuePath="Key" AutomationProperties.Name="既定の整形"/>
       </StackPanel>
       <TextBlock Text="1. チャンクの結合（子チャンク）" FontWeight="SemiBold" Margin="0,10,0,0"/>
       <ComboBox x:Name="ChildModeBox" SelectionChanged="UsageChanged" DisplayMemberPath="Label" SelectedValuePath="Key" AutomationProperties.Name="子チャンクの結合方式"/>
       <StackPanel x:Name="ChildPromptOptions">
       <TextBlock Text="LLMで結合する場合のプロンプト"/><ComboBox x:Name="DefaultChunkBox" SelectionChanged="UsageChanged" DisplayMemberPath="Label" SelectedValuePath="Key" AutomationProperties.Name="既定の結合"/>
       </StackPanel>
       <CheckBox x:Name="MechanicalJoinBox" Content="既定で機械的な結合を行う" Checked="MechanicalJoinChanged" Unchecked="MechanicalJoinChanged" Margin="0,6"/>
       <TextBlock Text="2. チャンクをまとめる（親チャンク）" FontWeight="SemiBold" Margin="0,10,0,0"/>
       <ComboBox x:Name="ParentModeBox" SelectionChanged="UsageChanged" DisplayMemberPath="Label" SelectedValuePath="Key" AutomationProperties.Name="親チャンクのまとめ方式"/>
       <StackPanel x:Name="MarkdownBoundsOptions">
       <TextBlock Text="Markdown・Word・PDFの親チャンクの長さ（文書構造でまとめる場合）" TextWrapping="Wrap" Margin="0,8,0,0"/>
       <UniformGrid Columns="2">
        <StackPanel Margin="0,0,12,0"><TextBlock Text="最小文字数（0なら短い章を結合しない）" TextWrapping="Wrap"/><TextBox x:Name="MarkdownParentMinBox" AutomationProperties.Name="Markdown親チャンクの最小文字数"/></StackPanel>
        <StackPanel><TextBlock Text="最大文字数"/><TextBox x:Name="MarkdownParentMaxBox" AutomationProperties.Name="Markdown親チャンクの最大文字数"/></StackPanel>
       </UniformGrid>
       <TextBlock Text="短い章は後続の章と結合します。最大を超える結合はせず、長い章は分割します。末尾などでは最小未満を許容します。新規Markdown設定の初期値：最小500・最大4,000文字。" TextWrapping="Wrap" Foreground="#526477"/>
       </StackPanel>
       <StackPanel x:Name="ParentPromptOptions">
       <TextBlock Text="LLMでまとめる場合のプロンプト"/><ComboBox x:Name="DefaultParentBox" DisplayMemberPath="Label" SelectedValuePath="Key" AutomationProperties.Name="親チャンクプロンプト"/>
       </StackPanel>
       <StackPanel x:Name="ParentEmbeddingOptions">
       <TextBlock Text="3. 文書の親チャンクも検索対象にする" FontWeight="SemiBold" Margin="0,12,0,0"/>
       <ComboBox x:Name="ParentEmbeddingBox" SelectionChanged="UsageChanged" DisplayMemberPath="Label" SelectedValuePath="Key" AutomationProperties.Name="親チャンクの埋め込み方式"/>
       <StackPanel x:Name="ParentDescriptionOptions">
       <TextBlock Text="親の説明を作るプロンプト"/><ComboBox x:Name="ParentDescriptionBox" DisplayMemberPath="Label" SelectedValuePath="Key" AutomationProperties.Name="親チャンクの説明プロンプト"/>
       </StackPanel>
       <TextBlock Text="Markdown・テキスト向け。子の本文も検索対象に残します。長い親の説明は子の説明から作り、検索結果には原文を返します。ソースコードには適用しません。" TextWrapping="Wrap" Foreground="#526477"/>
       </StackPanel>
       </StackPanel>
      </StackPanel>
     </Grid>
     <TextBlock x:Name="CategoryOptionsTitle" Text="有効カテゴリとカテゴリ別の処理" FontWeight="SemiBold" Margin="0,16,0,8"/>
     <DataGrid x:Name="RouteCategoryGrid" Height="230" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" AutomationProperties.Name="カテゴリ別処理">
      <DataGrid.Resources>
       <Style x:Key="ActiveStep" TargetType="ComboBox"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding ProcessingActive}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style>
      </DataGrid.Resources>
      <DataGrid.Columns><DataGridCheckBoxColumn x:Name="EnabledColumn" Header="有効" Binding="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}" Width="60"/>
       <DataGridTextColumn Header="カテゴリ" Binding="{Binding Name}" IsReadOnly="True" Width="180"/>
       <DataGridComboBoxColumn x:Name="FormatColumn" Header="整形" ElementStyle="{StaticResource ActiveStep}" EditingElementStyle="{StaticResource ActiveStep}" SelectedValueBinding="{Binding FormatKey, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Key" DisplayMemberPath="Label" Width="*"/>
       <DataGridComboBoxColumn x:Name="ChunkColumn" Header="チャンクの結合" ElementStyle="{StaticResource ActiveStep}" EditingElementStyle="{StaticResource ActiveStep}" SelectedValueBinding="{Binding ChunkKey, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Key" DisplayMemberPath="Label" Width="*"/>
       <DataGridComboBoxColumn x:Name="MechanicalColumn" Header="機械的な結合" ElementStyle="{StaticResource ActiveStep}" EditingElementStyle="{StaticResource ActiveStep}" SelectedValueBinding="{Binding JoinKey, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Key" DisplayMemberPath="Label" Width="*"/>
       <DataGridComboBoxColumn x:Name="ParentColumn" Header="チャンクをまとめる" ElementStyle="{StaticResource ActiveStep}" EditingElementStyle="{StaticResource ActiveStep}" SelectedValueBinding="{Binding ParentKey, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Key" DisplayMemberPath="Label" Width="*"/>
      </DataGrid.Columns>
     </DataGrid>
     <StackPanel x:Name="CommonOptions">
     <TextBlock Text="共通動作と文書構造（該当するほかの設定にも適用）" FontWeight="SemiBold" Margin="0,16,0,8"/>
     <CheckBox x:Name="ParentChunksBox" Checked="UsageChanged" Unchecked="UsageChanged" Content="共通動作で親チャンクを作る" Margin="0,4"/>
     <StackPanel x:Name="HeadingOptions" Orientation="Horizontal" Margin="0,4">
      <TextBlock Text="Markdownの章区切り：見出しレベル" VerticalAlignment="Center"/>
      <ComboBox x:Name="ParentLevelBox" Width="70" Margin="8,0" AutomationProperties.Name="親チャンクの見出しレベル"/>
      <TextBlock Text="までを区切りにする（既定：2）" VerticalAlignment="Center"/>
     </StackPanel>
     <CheckBox x:Name="ParagraphChildrenBox" Checked="UsageChanged" Unchecked="UsageChanged" Content="共通動作：子チャンクを段落単位にする（OFFならLLM結合。Markdownの機械的結合を除く）" Margin="0,4"/>
     </StackPanel>
     <Expander Header="入力と出力の共通上限（ほかの設定にも適用）" Margin="0,16,0,0"><UniformGrid Columns="3" Margin="0,8">
      <StackPanel Margin="0,0,14,0"><TextBlock Text="文書上限（文字）"/><TextBox x:Name="DocumentLimitBox" AutomationProperties.Name="文書上限"/></StackPanel>
      <StackPanel x:Name="ChunkLimitOptions" Margin="0,0,14,0"><TextBlock Text="チャンク上限（文字）"/><TextBox x:Name="ChunkLimitBox" AutomationProperties.Name="チャンク上限"/></StackPanel>
      <StackPanel x:Name="OutputLimitOptions"><TextBlock Text="AI応答上限（トークン）"/><TextBox x:Name="OutputLimitBox" AutomationProperties.Name="応答上限"/></StackPanel>
     </UniformGrid></Expander>
    </StackPanel></ScrollViewer>
   </TabItem>
   <TabItem Header="取得処理">
    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,8">
     <TextBlock Text="検索と全文取得に共通する設定" FontSize="20" FontWeight="SemiBold"/>
     <CheckBox x:Name="HierarchySearchBox" Content="親・子の類似度も評価して、返却単位と検索順位を決める" Margin="0,12,0,8"/>
     <UniformGrid Columns="3">
      <StackPanel Margin="0,0,8,0"><TextBlock Text="自身の重み"/><TextBox x:Name="HierarchySelfBox" AutomationProperties.Name="構造検索 自身の重み"/></StackPanel>
      <StackPanel Margin="0,0,8,0"><TextBlock Text="親の重み"/><TextBox x:Name="HierarchyParentBox" AutomationProperties.Name="構造検索 親の重み"/></StackPanel>
      <StackPanel><TextBlock Text="子の重み"/><TextBox x:Name="HierarchyChildBox" AutomationProperties.Name="構造検索 子の重み"/></StackPanel>
     </UniformGrid>
     <TextBlock Text="標準：自身0.6・親0.2・子0.2。埋め込みのない階層を除いて重みを調整します。子は関連度の高い最大3単位を評価します。無効にすると従来の類似度順で検索します。再取り込みは不要です。" TextWrapping="Wrap" Foreground="#526477" Margin="0,4,0,10"/>
     <TextBlock Text="メディアやカテゴリで分岐せず、管理画面とMCPの取得に同じ秘匿設定を適用します。" TextWrapping="Wrap" Margin="0,8,0,18"/>
     <CheckBox x:Name="ConfidentialityBox" Content="秘匿機能を使用する" Margin="0,8,0,12"/>
     <TextBlock Text="無効にすると、未検査の本文と出典が取得先へ返ります。有効な検査手段がない場合は、判定保留として本文を返しません。" TextWrapping="Wrap" Foreground="#755620" Margin="0,0,0,16"/>
     <StackPanel IsEnabled="{Binding IsChecked, ElementName=ConfidentialityBox}">
     <CheckBox x:Name="BoundaryPatternsBox" Content="先頭・末尾の指定行をパターンで検査する" Margin="0,0,0,8"/>
     <StackPanel x:Name="BoundaryPatternOptions">
      <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsChecked, ElementName=BoundaryPatternsBox}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
      <UniformGrid Columns="2">
       <StackPanel Margin="0,0,8,0"><TextBlock Text="先頭の行数（m）"/><TextBox x:Name="LeadingLinesBox" AutomationProperties.Name="秘匿検査 先頭行数"/></StackPanel>
       <StackPanel><TextBlock Text="末尾の行数（n）"/><TextBox x:Name="TrailingLinesBox" AutomationProperties.Name="秘匿検査 末尾行数"/></StackPanel>
      </UniformGrid>
      <TextBlock Text="初期値：先頭5行・末尾0行。0はその側を検査しません。元文書の改行で数え、空行も含めます。返却チャンクの先頭・末尾ではありません。" TextWrapping="Wrap" Foreground="#526477" Margin="0,4,0,8"/>
      <TextBlock Text="先頭・末尾用パターン（1行に1件・正規表現。大文字小文字を区別しません）" TextWrapping="Wrap"/>
      <TextBox x:Name="BoundaryPatternTextBox" Height="100" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="先頭・末尾の秘匿パターン"/>
     </StackPanel>
     <CheckBox x:Name="PatternsBox" Content="文書全体をパターンで検査する" Margin="0,12,0,8"/>
     <StackPanel>
      <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsChecked, ElementName=PatternsBox}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
      <TextBlock Text="全文用パターン（1行に1件・正規表現。大文字小文字を区別しません）" TextWrapping="Wrap"/>
      <TextBox x:Name="PatternTextBox" Height="100" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="全文の秘匿パターン"/>
      <TextBlock Text="元文書全体と返却候補を検査します。以前の設定のパターンはこの欄に引き継ぎます。先頭・末尾だけで検査したいパターンは、上の欄に設定してからこの欄から削除してください。" TextWrapping="Wrap" Foreground="#526477" Margin="0,4,0,10"/>
     </StackPanel>
     <CheckBox x:Name="LlmBox" Content="ローカルAIで秘匿判定する（試験的 / experimental）" Margin="0,0,0,8"/>
     <TextBlock Text="既定はOFFです。モデルによっては公開してよい文書も非開示と判定するため、必要な場合に有効にしてください。一致パターン検査の設定は独立しています。" TextWrapping="Wrap" Foreground="#526477" Margin="0,0,0,12"/>
     <TextBlock Text="秘匿判定用プロンプト"/><ComboBox x:Name="ConfidentialityPromptBox" DisplayMemberPath="Label" SelectedValuePath="Key" AutomationProperties.Name="秘匿判定プロンプト"/>
     </StackPanel>
     <TextBlock Text="ソースコード検索：1件の返却上限（文字数）" Margin="0,16,0,4"/>
     <TextBox x:Name="CodeResultLimitBox" AutomationProperties.Name="ソースコード検索の返却上限"/>
     <TextBlock Text="標準8,000文字。クラスが長い場合は関数、直接ヒットしたクラス・ファイルが長い場合は一覧と説明へ縮小します。全文取得には適用しません。" TextWrapping="Wrap" Foreground="#526477"/>
    </StackPanel></ScrollViewer>
   </TabItem>
  </TabControl>
  <TextBlock Grid.Row="2" x:Name="ManagerStatus" TextWrapping="Wrap" Foreground="#A02727" Margin="0,10" MaxHeight="90"/>
  <DockPanel Grid.Row="3" LastChildFill="False">
   <Button DockPanel.Dock="Left" Content="デフォルトに戻す" Click="ResetDefaults" AutomationProperties.Name="パイプライン設定全体をデフォルトに戻す"/>
   <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
   <Button Content="キャンセル" IsCancel="True"/>
   <Button Content="保存して適用" Click="Apply" Background="#173F66" Foreground="White"/>
   </StackPanel>
  </DockPanel>
 </Grid>
</Window>
